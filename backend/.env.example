# Leave EMBEDDED_POSTGRES unset (or true) to start a local PostgreSQL
# from the API process. Set it to false to use an existing server.
EMBEDDED_POSTGRES=true
EMBEDDED_PORT=54329
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/ab_invoice
PORT=9004
CORS_ORIGIN=http://localhost:9003
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_DISPLAY_NAME=Administrator
